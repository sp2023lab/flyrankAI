APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/widget_platform
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_WIDGET_PER_MINUTE=100
MAX_SUBMISSION_BODY_BYTES=16384
TRUST_PROXY=false
IP_HASH_SALT=replace-with-a-long-random-local-value
GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_B_ENABLED=true
GEO_REQUEST_TIMEOUT_SECONDS=1.5
NOTIFICATION_MODE=console
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_POLL_INTERVAL_SECONDS=2
NOTIFICATION_FORCE_FAIL=false
SEED_TENANT_NAME=Demo Tenant
SEED_TENANT_API_KEY=replace-with-a-long-random-local-api-key
SEED_WIDGET_ORIGIN=http://localhost:5500
